# Copie para .env (no servidor) e preencha. O .env não vai para o Git.
APP_PORT=8090
TZ_NAME=America/Belem
SESSION_TTL_MIN=60
MAX_UPLOAD_MB=40

# Deixe vazio para não pedir senha na tela
APP_USER=
APP_PASSWORD=

# Aviso por e-mail quando uma importação falha
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=localizaaluno@xinguara.pa.gov.br
SMTP_PASSWORD=
# Quem recebe os avisos (vazio = o próprio SMTP_USER)
ADMIN_EMAIL=
